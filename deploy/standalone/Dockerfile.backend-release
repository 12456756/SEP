# Dependency reuse is allowed only after the deployment script compares all
# workspace manifests and the lockfile with the archived production source.
ARG SEP_BUILDER_BASE_IMAGE=sep-migrator:42fc2644a38b
ARG SEP_RUNNER_BASE_IMAGE=sep-green-backend:42fc2644a38b
FROM ${SEP_BUILDER_BASE_IMAGE} AS builder
WORKDIR /app
COPY . .
RUN ln -sfn .pnpm/tar-stream@3.2.0/node_modules/tar-stream /app/node_modules/tar-stream && \
    pnpm --filter backend exec prisma generate && pnpm --filter backend run build
COPY backend/prisma /prod-bundle/prisma
RUN node deploy/standalone/prisma-client-artifact.cjs sync /app/backend /prod-bundle && \
    node deploy/standalone/prisma-client-artifact.cjs check /prod-bundle

FROM builder AS migrator
CMD ["sh", "-c", "pnpm --filter backend exec prisma migrate deploy"]

FROM ${SEP_RUNNER_BASE_IMAGE} AS runner
USER root
COPY --from=builder /prod-bundle/node_modules /app/node_modules
RUN ln -sfn .pnpm/tar-stream@3.2.0/node_modules/tar-stream /app/node_modules/tar-stream
COPY --from=builder /app/backend/dist /app/dist
COPY --from=builder /prod-bundle/prisma /app/prisma
COPY --from=builder /app/deploy/standalone/prisma-client-artifact.cjs /app/prisma/prisma-client-artifact.cjs
USER node
RUN node /app/prisma/prisma-client-artifact.cjs check /app
