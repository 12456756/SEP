# Dependency reuse is allowed only after the deployment script compares all
# workspace manifests and the lockfile with the archived production source.
ARG SEP_BUILDER_BASE_IMAGE=sep-green-backend:42fc2644a38b
ARG SEP_RUNNER_BASE_IMAGE=sep-green-backend:42fc2644a38b
FROM ${SEP_BUILDER_BASE_IMAGE} AS builder
WORKDIR /app
COPY . .
RUN ln -s .pnpm/tar-stream@3.2.0/node_modules/tar-stream /app/node_modules/tar-stream && \
    pnpm --filter backend exec prisma generate && pnpm --filter backend run build
RUN cp -r /app/backend/prisma /prod-bundle/prisma && \
    /app/backend/node_modules/.bin/prisma generate --schema=/prod-bundle/prisma/schema.prisma

FROM builder AS migrator
CMD ["sh", "-c", "pnpm --filter backend exec prisma migrate deploy"]

FROM ${SEP_RUNNER_BASE_IMAGE} AS runner
USER root
COPY --from=builder /prod-bundle/node_modules /app/node_modules
RUN ln -s .pnpm/tar-stream@3.2.0/node_modules/tar-stream /app/node_modules/tar-stream
COPY --from=builder /app/backend/dist /app/dist
COPY --from=builder /app/backend/prisma /app/prisma
USER node
