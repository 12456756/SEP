# ═══════════════════════════════════════════════════════════════════════════════
# SEP 生产环境变量
# 复制此文件为 .env 并填写所有值
# ═══════════════════════════════════════════════════════════════════════════════

# ── 从 /opt/longdao/deploy/production/.env 复制以下三项 ──────────────────────
POSTGRES_USER=sub2api
POSTGRES_PASSWORD=
SEP_DB_USER=sep_app
SEP_DB_PASSWORD=
# 当前 longdao-redis 未启用 AUTH，默认使用 DB 1；启用认证时改为完整 redis:// URL
REDIS_URL=redis://longdao-redis:6379/1
# 仅供启用认证的旧配置保留，不会覆盖 REDIS_URL
REDIS_PASSWORD=

# ── SEP 专属配置 ──────────────────────────────────────────────────────────────

# 兼容旧模块的 JWT 密钥（生成命令：openssl rand -hex 32）
JWT_SECRET=
# 认证中心专用密钥：必须分别生成，不能互相复用（均至少 32 字符）
ACCESS_JWT_SECRET=
REFRESH_TOKEN_PEPPER=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=__Host-sep_refresh
CORS_ORIGIN=https://sep.longdaoec.com
# 默认为空，不信任转发头。仅在核实 Caddy/Next 代理链并限制后端直连入口后填写实际代理 IP/CIDR。
TRUSTED_PROXY_CIDRS=
NEXT_PUBLIC_WS_URL=wss://sep.longdaoec.com

# Next.js external API rewrite timeout (positive integer milliseconds).
SEP_API_PROXY_TIMEOUT_MS=180000

# Stable instance ID must also be registered in the signed desktop client.
SKILL_IMPORT_ENABLED=false
SKILL_IMPORT_INSTANCE_ID=
SKILL_IMPORT_MIN_CLIENT_VERSION=1.0.0
SKILL_IMPORT_UPLOAD_CONCURRENCY=1

# 邮件（生产必须启用，用于密码找回、邮箱验证、新设备通知）
MAIL_ENABLED=true
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=硅基人才平台

# 国内第三方登录（未完成开放平台备案/回调配置前保持 false）
OAUTH_TRANSACTION_TTL_SECONDS=300
WECHAT_OAUTH_ENABLED=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=https://sep.longdaoec.com/api/auth/oauth/wechat/callback
QQ_OAUTH_ENABLED=false
QQ_APP_ID=
QQ_APP_KEY=
QQ_REDIRECT_URI=https://sep.longdaoec.com/api/auth/oauth/qq/callback
DINGTALK_OAUTH_ENABLED=false
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_REDIRECT_URI=https://sep.longdaoec.com/api/auth/oauth/dingtalk/callback
DINGTALK_SCOPE=openid

# 蓝绿发布后的有界观察（部署脚本读取，可按生产告警窗口调整）
SEP_POST_DEPLOY_CHECKS=6
SEP_POST_DEPLOY_INTERVAL_SECONDS=10

# sub2api API Key
# 在 sub2api 管理后台（https://ai.longdaoec.com）创建一个渠道 key，填入此处
SUB2API_API_KEY=

# 模型 HTTP 请求频率：按企业/成员/订阅隔离，跨任务及模型共享
GATEWAY_MODEL_RATE_LIMIT=60
GATEWAY_MODEL_RATE_WINDOW_MS=60000

# Streaming upstream timeouts (milliseconds): headers, idle gap, total duration.
GATEWAY_STREAM_HEADER_TIMEOUT_MS=120000
GATEWAY_STREAM_IDLE_TIMEOUT_MS=120000
GATEWAY_STREAM_TOTAL_TIMEOUT_MS=600000

# sub2api 地址与默认模型
# 使用独立的模型中转域名；不要依赖与 SEP 同宿主的 Docker 服务名。
# 模型必须是中转真实提供的：
#   curl -H "Authorization: Bearer $SUB2API_API_KEY" <base_url>/models
# 实测该中转只提供 gemini-* 系列，填 gpt-* / claude-* 会 404 model_not_found。
SUB2API_BASE_URL=https://ai.longdaoec.com/v1
SUB2API_DEFAULT_MODEL=gemini-3.5-flash-high

# 知识库 Embedding（独立 Ollama 服务）
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://sep-ollama:11434
EMBEDDING_MODEL=bge-m3:sep-790764642607
EMBEDDING_MODEL_DIGEST=sha256:7907646426070047a77226ac3e684fbbe8410524f7b4a74d02837e43f2146bab
EMBEDDING_TOKENIZER=BAAI/bge-m3@5617a9f61b028005a4858fdac845db406aefb181
# Prepare this HOST directory before rollout; Compose mounts it read-only at /app/tokenizers.
KNOWLEDGE_TOKENIZERS_HOST_PATH=/opt/sep/tokenizers
KNOWLEDGE_PRIVATE_HOST_PATH=/opt/sep/knowledge
EMBEDDING_TOKENIZER_PATH=/app/tokenizers/bge-m3/5617a9f61b028005a4858fdac845db406aefb181
EMBEDDING_DISTANCE=cosine
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=8
EMBEDDING_TIMEOUT_MS=120000

# ---- SEP 专属数据库角色（必填）---------------------------------------------
# 这台机器的 PostgreSQL 与龙道 AI 中转共用实例。SEP 必须使用自己的低权角色，
# 不要复用中转的超级用户（POSTGRES_USER）。建角色见 docs 或运维脚本：
#   CREATE ROLE sep_app LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE PASSWORD '...';
#   ALTER DATABASE sep_prod OWNER TO sep_app;   -- 连同库内对象属主一起迁移
#   REVOKE CONNECT ON DATABASE sub2api FROM PUBLIC;  -- 禁止 SEP 连中转的库
SEP_DB_USER=sep_app
SEP_DB_PASSWORD=
