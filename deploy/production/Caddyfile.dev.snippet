# SEP shared client integration environment
(sep_dev_skill_import_proxy) {
    reverse_proxy sep-dev-backend:3001 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        transport http {
            response_header_timeout 300s
            read_timeout 300s
            write_timeout 300s
        }
    }
}

{$SEP_DEV_DOMAIN} {
    tls {$LONGDAO_ACME_EMAIL} {
        protocols tls1.2 tls1.3
    }

    @skill_import path /api/skill-import /api/skill-import/*
    handle @skill_import {
        @package {
            method POST
            path_regexp dev_skill_package ^/api/skill-import/connector/sessions/[A-Za-z0-9_-]{1,160}/package/?$
        }
        handle @package {
            request_body {
                max_size 105906176
            }
            import sep_dev_skill_import_proxy
        }
        @events {
            method POST
            path_regexp dev_skill_events ^/api/skill-import/connector/sessions/[A-Za-z0-9_-]{1,160}/events/?$
        }
        handle @events {
            request_body {
                max_size 16777216
            }
            import sep_dev_skill_import_proxy
        }
        handle {
            request_body {
                max_size 2097152
            }
            import sep_dev_skill_import_proxy
        }
    }

    @sep_dev_ws path /ws/*
    reverse_proxy @sep_dev_ws sep-dev-backend:3001

    reverse_proxy sep-dev-web:3000 {
        flush_interval -1
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}
    }

    encode {
        zstd
        gzip 6
        minimum_length 256
        match {
            header Content-Type text/html*
            header Content-Type text/css*
            header Content-Type text/plain*
            header Content-Type application/json*
            header Content-Type application/javascript*
            header Content-Type image/svg+xml*
        }
    }

    @ordinary_body not path /api/skill-import /api/skill-import/*
    request_body @ordinary_body {
        max_size 100MB
    }

    log {
        output file /var/log/caddy/sep-dev.log {
            roll_size 50mb
            roll_keep 5
            roll_keep_for 720h
        }
        format json
        level INFO
    }
}
